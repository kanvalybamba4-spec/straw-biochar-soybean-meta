# --- 9. READ ESTIMATES BACK (CSV is the single source for the plot) ---
obs <- read.csv(file.path(output_dir, "Subgroup_estimates.csv"),
                stringsAsFactors = FALSE)
obs$lnRR <- obs$estimate
obs$Amendment <- factor(obs$Amendment, levels = c("Biochar", "Straw"))

# --- 10. SLOT GRID (2 sub-rows per level) ---
mod_order <- c("N fertilizer rate", "Initial SOC", "Soil pH", "Exp duration",
               "MAT", "MAP", "Soil type")
lvl_list <- list(
  "N fertilizer rate" = c("N0", "Low (<75)", "Medium (75-150)", "High (>150)"),
  "Initial SOC"        = c("Low (<=10)", "Medium (10-20)", "High (>20)"),
  "Soil pH"            = c("Acid (<=6.5)", "Neutral (6.5-7.5)", "Alkaline (>=7.5)"),
  "Exp duration"       = c("Short (<=3)", "Medium (3-5)", "Long (>5)"),
  "MAT"                = c("<=10", "10-20", ">20"),
  "MAP"                = c("<=600", "600-1000", ">1000"),
  "Soil type"          = c("Black soil", "Loam", "Clayey", "Sandy"))
amend_order <- c("Biochar", "Straw")

build_grid <- function() {
  rec <- list(); lvlrec <- list(); band <- list()
  y <- 1
  for(m in mod_order) {
    m_first <- y; m_last <- y
    for(lv in lvl_list[[m]]) {
      lvl_start <- y
      for(am in amend_order) {
        rec[[length(rec)+1]] <- data.frame(Moderator = m, Level = lv,
                                           Amendment = am, ypos = y)
        m_last <- y; y <- y + 1
      }
      lvlrec[[length(lvlrec)+1]] <- data.frame(Moderator = m, Level = lv,
                                               y = lvl_start + 0.5)
      y <- y + 0.6
    }
    band[[length(band)+1]] <- data.frame(Moderator = m,
                                         ymin = m_first - 0.5, ymax = m_last + 0.5,
                                         y = (m_first + m_last) / 2)
    y <- y + 1.2
  }
  list(grid = do.call(rbind, rec), lvls = do.call(rbind, lvlrec),
       bands = do.call(rbind, band))
}
G <- build_grid()
grid0 <- G$grid; lvlz <- G$lvls; bands <- G$bands
grid <- rbind(transform(grid0, Outcome = "SOC"), transform(grid0, Outcome = "Yield"))
plot_df <- left_join(grid, obs, by = c("Outcome", "Moderator", "Level", "Amendment"))

panels <- data.frame(Outcome = c("Yield", "SOC"),
                     Panel = factor(c("(a) Crop yield", "(b) Soil organic carbon"),
                                    levels = c("(a) Crop yield", "(b) Soil organic carbon")))
plot_df <- left_join(plot_df, panels, by = "Outcome")
bands2 <- merge(bands, panels, by = NULL)
mod_lab <- merge(bands[, c("Moderator", "y")], panels, by = NULL)
seps <- data.frame(y = lvlz$y + 0.8)

# --- 11. COLORS ---
amend_pal <- c("Biochar" = "#C0392B", "Straw" = "#E67E22")
band_cols <- c("N fertilizer rate" = "#E41A1C", "Initial SOC" = "#FF7F00",
               "Soil pH" = "#377EB8", "Exp duration" = "#4DAF4A", "MAT" = "#984EA3",
               "MAP" = "#F781BF", "Soil type" = "#1ABC9C")
bands2$fill <- band_cols[bands2$Moderator]

# --- 12. PLOT ---
p <- ggplot(plot_df, aes(x = lnRR, y = ypos)) +
  geom_rect(data = bands2,
            aes(xmin = -Inf, xmax = Inf, ymin = ymin, ymax = ymax, fill = fill),
            colour = "grey50", linewidth = 0.3, alpha = 0.22, inherit.aes = FALSE) +
  scale_fill_identity() +
  geom_hline(data = seps, aes(yintercept = y), linetype = "dashed",
             colour = "grey60", linewidth = 0.3) +
  geom_vline(xintercept = 0, linetype = "dashed", colour = "grey30", linewidth = 0.4) +
  geom_errorbarh(aes(xmin = ci.lb, xmax = ci.ub, colour = Amendment),
                 height = 0.1, linewidth = 0.5) +
  geom_point(aes(colour = Amendment), shape = 15, size = 2.4) +
  geom_text(aes(x = ci.ub, label = paste0("n=", k), colour = Amendment),
            hjust = -0.15, size = 2.3, show.legend = FALSE) +
  geom_text(data = mod_lab, aes(x = -0.015, y = y, label = Moderator),
            hjust = 1, size = 3.1, fontface = "bold", colour = "black",
            inherit.aes = FALSE) +
  scale_colour_manual(values = amend_pal, name = "Amendment type") +
  facet_wrap(~ Panel, nrow = 1) +
  scale_y_continuous(breaks = lvlz$y, labels = lvlz$Level, trans = "reverse") +
  scale_x_continuous(breaks = seq(0, 0.4, 0.1)) +
  coord_cartesian(xlim = c(-0.18, 0.48), clip = "off") +
  labs(x = "Effect size (lnRR with 95% CI)", y = NULL) +
  theme_bw(base_size = 11, base_family = "Times") +
  theme(strip.text = element_text(face = "bold", size = 10),
        strip.background = element_rect(fill = "grey85", colour = "grey50"),
        panel.grid = element_blank(),
        axis.text.y = element_text(size = 8.7, colour = "black"),
        axis.text.x = element_text(size = 9),
        legend.position = "bottom",
        panel.spacing = unit(0.5, "cm"),
        plot.margin = margin(8, 10, 8, 8))
print(p)

# --- 13. SAVE ---
ggsave(file.path(output_dir, "Subgroup_forest_Biochar_Straw.pdf"),
       p, width = 10, height = 10, units = "in")
ggsave(file.path(output_dir, "Subgroup_forest_Biochar_Straw.png"),
       p, width = 10, height = 10, units = "in", dpi = 600)
