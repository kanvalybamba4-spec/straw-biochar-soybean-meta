# ==============================================================
# SUBGROUP FOREST PLOT - BIOCHAR vs STRAW (MIXTURE EXCLUDED)
# Combined pipeline: (1) compute pooled lnRR per outcome x
# moderator x level x amendment from Bookfull_soiltype_4class.xlsx,
# (2) export Subgroup_estimates.csv (usable as a verifiable
# supplementary table), (3) draw the forest figure.
#
# Input : Bookfull_soiltype_4class.xlsx (sheet "clean_data"),
#         which contains the recoded soil_type column.
# Outputs: Subgroup_estimates.csv, Subgroup_forest_Biochar_Straw.pdf,
#          Subgroup_forest_Biochar_Straw.png (600 dpi).
#
# ==============================================================
# --- 1. PACKAGES ---
packages <- c("metafor", "readxl", "dplyr", "ggplot2")
new_pkgs <- packages[!(packages %in% installed.packages()[,"Package"])]
if(length(new_pkgs)) install.packages(new_pkgs)
library(metafor); library(readxl); library(dplyr); library(ggplot2)

# --- 2. CONFIGURATION ---
output_dir <- "C:/Users/OMEN/Desktop/4eme"
input_file <- "Bookfull_soiltype_4class.xlsx"

# --- 3. READ DATA ---
df <- read_excel(file.path(output_dir, input_file), sheet = "clean_data")
df <- df %>% filter(!is.na(yi), !is.na(vi), vi > 0,
                    amendment_type %in% c("Biochar", "Straw"))
cat("Rows kept:", nrow(df), "\n")

# --- 4. BINNING RULES (thresholds fixed a priori) ---
bin_N   <- function(x) case_when(x == 0 ~ "N0",
                                 x < 75 ~ "Low (<75)",
                                 x <= 150 ~ "Medium (75-150)",
                                 TRUE ~ "High (>150)")
bin_SOC <- function(x) case_when(x <= 10 ~ "Low (<=10)",
                                 x <= 20 ~ "Medium (10-20)",
                                 TRUE ~ "High (>20)")
bin_pH  <- function(x) case_when(x <= 6.5 ~ "Acid (<=6.5)",
                                 x < 7.5 ~ "Neutral (6.5-7.5)",
                                 TRUE ~ "Alkaline (>=7.5)")
bin_dur <- function(x) case_when(x <= 3 ~ "Short (<=3)",
                                 x <= 5 ~ "Medium (3-5)",
                                 TRUE ~ "Long (>5)")
bin_MAT <- function(x) case_when(x <= 10 ~ "<=10",
                                 x <= 20 ~ "10-20",
                                 TRUE ~ ">20")
bin_MAP <- function(x) case_when(x <= 600 ~ "<=600",
                                 x <= 1000 ~ "600-1000",
                                 TRUE ~ ">1000")

# --- 5. LONG DATA (one row per observation per moderator) ---
mk <- function(dat, mod, lv) {
  dat %>% transmute(Outcome = Variable, Moderator = mod,
                    Level = lv, Amendment = amendment_type, yi = yi, vi = vi)
}
long <- bind_rows(
  mk(df, "N fertilizer rate", bin_N(df$N_rate)),
  mk(df, "Initial SOC",       bin_SOC(df$initial_SOC)),
  mk(df, "Soil pH",           bin_pH(df$soil_pH)),
  mk(df, "Exp duration",      bin_dur(df$exp_duration)),
  mk(df, "MAT",               bin_MAT(df$MAT)),
  mk(df, "MAP",               bin_MAP(df$MAP)),
  mk(df, "Soil type",         df$soil_type)
) %>% filter(!is.na(Level))

# --- 6. ROBUST MODEL FITTING PER CELL ---
# REML -> REML (reduced step) -> FE, with the estimator recorded.
fit_cell <- function(sub) {
  if(nrow(sub) < 2) {
    res <- rma(yi = yi, vi = vi, data = sub, method = "FE")
    return(list(res = res, model = "FE"))
  }
  res <- try(rma(yi = yi, vi = vi, data = sub, method = "REML"),
             silent = TRUE)
  if(!inherits(res, "try-error")) return(list(res = res, model = "REML"))

  res2 <- try(rma(yi = yi, vi = vi, data = sub, method = "REML",
                  control = list(stepadj = 0.5, maxiter = 1000)),
              silent = TRUE)
  if(!inherits(res2, "try-error")) return(list(res = res2, model = "REML"))

  res3 <- rma(yi = yi, vi = vi, data = sub, method = "FE")
  return(list(res = res3, model = "FE"))
}

ests <- long %>%
  group_by(Outcome, Moderator, Level, Amendment) %>%
  group_modify(~ {
    fit <- fit_cell(.x)
    res <- fit$res
    tibble(k       = nrow(.x),
           model   = fit$model,
           estimate = as.numeric(res$b[1]),
           ci.lb    = res$ci.lb,
           ci.ub    = res$ci.ub,
           pval     = res$pval,
           I2       = round(res$I2, 1),
           tau2     = round(res$tau2, 6))
  }) %>%
  ungroup()

# --- 7. EXPORT CSV (rounds to manuscript precision) ---
ests_out <- ests %>%
  mutate(across(c(estimate, ci.lb, ci.ub), ~ round(.x, 3)),
         pval = round(pval, 4))
write.csv(ests_out, file.path(output_dir, "Subgroup_estimates.csv"),
          row.names = FALSE)
cat("Subgroup_estimates.csv saved (", nrow(ests_out), " rows)\n")
cat("Models used:\n"); print(table(ests$model))

# --- 8. SANITY CHECK: k sums must match global amendment totals ---
chk <- ests %>% group_by(Outcome, Amendment) %>%
  summarise(total_k = sum(k), .groups = "drop")
print(as.data.frame(chk))

